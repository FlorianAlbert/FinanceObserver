{
    "configurations": [
        // The first configuration is the preferred way to launch Aspire applications.
        // At the moment there is a bug in the Aspire extension that prevents it from working correctly (https://github.com/dotnet/aspire/issues/12965).
        // Once that bug is fixed, the following configuration can be uncommented and used instead.
        // {
        //     "type": "aspire",
        //     "request": "launch",
        //     "name": "Aspire: Launch default apphost",
        //     "program": "${workspaceFolder}"
        // },
        {
            "name": "Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/AspireInfrastructure/AppHost/AppHost.csproj",
        }
    ]
}